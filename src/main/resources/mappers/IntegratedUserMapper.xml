<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.dong.user2.IntegratedUserMapper">

    <resultMap id="integratedUserResultMap" type="kr.co.dong.user2.IntegratedUserVO">
        <id property="userId" column="user_id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="nickname" column="nickname"/>
        <result property="email" column="email"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="login" resultMap="integratedUserResultMap">
        SELECT * FROM integrated_user
        WHERE username = #{username} AND password = #{password}
    </select>

    <select id="selectOne" parameterType="int" resultMap="integratedUserResultMap">
        SELECT * FROM integrated_user WHERE user_id = #{userId}
    </select>

    <insert id="insert" parameterType="kr.co.dong.user2.IntegratedUserVO">
        INSERT INTO integrated_user (username, password, nickname, email)
        VALUES (#{username}, #{password}, #{nickname}, #{email})
    </insert>

    <update id="update" parameterType="kr.co.dong.user2.IntegratedUserVO">
        UPDATE integrated_user
        SET nickname = #{nickname}, email = #{email}
        WHERE user_id = #{userId}
    </update>

    <delete id="delete" parameterType="int">
        DELETE FROM integrated_user WHERE user_id = #{userId}
    </delete>
    <select id="checkUsername" parameterType="string" resultType="int">   <!-- ← 추가 -->
        SELECT COUNT(*) FROM integrated_user WHERE username = #{username}
    </select>

</mapper>